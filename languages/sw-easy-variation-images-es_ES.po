msgid ""
msgstr ""
"Project-Id-Version: SW Easy Variation Images\n"
"Language: es_ES\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"
"X-Domain: sw-easy-variation-images\n"

msgid "Set one image per attribute value (for example, per color) and every matching WooCommerce variation gets it. Works with any theme; supports variation galleries of WooCommerce, WoodMart and Additional Variation Images Gallery."
msgstr "Asigna una imagen por valor de atributo (por ejemplo, por color) y todas las variaciones de WooCommerce con ese valor la reciben. Funciona con cualquier tema; compatible con las galerías de variaciones de WooCommerce, WoodMart y Additional Variation Images Gallery."

msgid "Choose image"
msgstr "Elegir imagen"

msgid "Choose additional images"
msgstr "Elegir imágenes adicionales"

msgid "Use this image"
msgstr "Usar esta imagen"

msgid "Use these images"
msgstr "Usar estas imágenes"

msgid "There are unsaved changes in the variations. Save them first, then apply the images."
msgstr "Hay cambios sin guardar en las variaciones. Guárdalos primero y después aplica las imágenes."

msgid "Changed, not applied yet"
msgstr "Cambiado, sin aplicar"

msgid "Working…"
msgstr "Procesando…"

msgid "Something went wrong. Reload the page and try again."
msgstr "Algo ha fallado. Recarga la página e inténtalo de nuevo."

msgid "WooCommerce variation gallery"
msgstr "galería de variaciones de WooCommerce"

msgid "WoodMart variation gallery"
msgstr "galería de variaciones de WoodMart"

msgid "Additional Variation Images Gallery plugin"
msgstr "plugin Additional Variation Images Gallery"

msgid "Images by attribute"
msgstr "Imágenes por atributo"

msgid "Share images by:"
msgstr "Compartir imágenes por:"

msgid "Hide"
msgstr "Ocultar"

msgid "Show"
msgstr "Mostrar"

msgid "The panel shows the current images of the variations. Nothing changes until you press “Apply” in a row: only the variations of that value are changed."
msgstr "El panel muestra las imágenes actuales de las variaciones. No se cambia nada hasta que pulses «Aplicar» en una fila: solo cambian las variaciones de ese valor."

#, php-format
msgid "Additional images are saved to: %s."
msgstr "Las imágenes adicionales se guardan en: %s."

msgid "This site has no variation gallery, so only the main image of the variations is shared."
msgstr "Este sitio no tiene galería de variaciones, así que solo se comparte la imagen principal."

msgid "Undo"
msgstr "Deshacer"

msgid "Main image"
msgstr "Imagen principal"

msgid "Additional images (gallery)"
msgstr "Imágenes adicionales (galería)"

msgid "Variations"
msgstr "Variaciones"

msgid "Choose"
msgstr "Elegir"

msgid "Remove"
msgstr "Quitar"

msgid "Choose"
msgstr "Elegir"

msgid "Remove"
msgstr "Quitar"

msgid "Replace in all"
msgstr "Sustituir en todas"

msgid "Only empty ones"
msgstr "Solo las vacías"

msgid "Cancel"
msgstr "Cancelar"

msgid "No variations"
msgstr "Sin variaciones"

msgid "all the same"
msgstr "todas iguales"

msgid "Nothing to change: the variations already had these images."
msgstr "Nada que cambiar: las variaciones ya tenían estas imágenes."

#, php-format
msgid "Last change: %1$s, %2$d variation."
msgid_plural "Last change: %1$s, %2$d variations."
msgstr[0] "Último cambio: %1$s, %2$d variación."
msgstr[1] "Último cambio: %1$s, %2$d variaciones."

#, php-format
msgid "Apply to %d variation"
msgid_plural "Apply to %d variations"
msgstr[0] "Aplicar a %d variación"
msgstr[1] "Aplicar a %d variaciones"

#, php-format
msgid "%d variation uses “Any” for this attribute and is not changed."
msgid_plural "%d variations use “Any” for this attribute and are not changed."
msgstr[0] "%d variación usa «Cualquiera» en este atributo y no se modifica."
msgstr[1] "%d variaciones usan «Cualquiera» en este atributo y no se modifican."

#, php-format
msgid "%d variation"
msgid_plural "%d variations"
msgstr[0] "%d variación"
msgstr[1] "%d variaciones"

#, php-format
msgid "%d with other images"
msgid_plural "%d with other images"
msgstr[0] "%d con otras imágenes"
msgstr[1] "%d con otras imágenes"

#, php-format
msgid "%d without images"
msgid_plural "%d without images"
msgstr[0] "%d sin imágenes"
msgstr[1] "%d sin imágenes"

#, php-format
msgid "%d variation already has other images. Replace them too?"
msgid_plural "%d variations already have other images. Replace them too?"
msgstr[0] "%d variación ya tiene otras imágenes. ¿Sustituirlas también?"
msgstr[1] "%d variaciones ya tienen otras imágenes. ¿Sustituirlas también?"

#, php-format
msgid "Done: %d variation updated."
msgid_plural "Done: %d variations updated."
msgstr[0] "Hecho: %d variación actualizada."
msgstr[1] "Hecho: %d variaciones actualizadas."

#, php-format
msgid "Undone: %d variation restored."
msgid_plural "Undone: %d variations restored."
msgstr[0] "Deshecho: %d variación restaurada."
msgstr[1] "Deshecho: %d variaciones restauradas."

#, php-format
msgid "New variations: %d got the images of their value."
msgid_plural "New variations: %d got the images of their value."
msgstr[0] "Variaciones nuevas: %d recibieron las imágenes de su valor."
msgstr[1] "Variaciones nuevas: %d recibieron las imágenes de su valor."
