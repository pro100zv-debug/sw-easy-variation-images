msgid ""
msgstr ""
"Project-Id-Version: SW Easy Variation Images\n"
"Language: ru_RU\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=3; plural=(n%10==1 && n%100!=11 ? 0 : n%10>=2 && n%10<=4 && (n%100<10 || n%100>=20) ? 1 : 2);\n"
"X-Domain: sw-easy-variation-images\n"

msgid "Set one image per attribute value (for example, per color) and every matching WooCommerce variation gets it. Works with any theme; supports variation galleries of WooCommerce, WoodMart and Additional Variation Images Gallery."
msgstr "Задайте одно фото для значения атрибута (например, для цвета) — и все вариации WooCommerce с этим значением получат его. Работает с любой темой; поддерживает галереи вариаций WooCommerce, WoodMart и Additional Variation Images Gallery."

msgid "Choose image"
msgstr "Выбрать изображение"

msgid "Choose additional images"
msgstr "Выбрать дополнительные изображения"

msgid "Use this image"
msgstr "Использовать это изображение"

msgid "Use these images"
msgstr "Использовать эти изображения"

msgid "There are unsaved changes in the variations. Save them first, then apply the images."
msgstr "В вариациях есть несохранённые изменения. Сначала сохраните их, затем примените изображения."

msgid "Changed, not applied yet"
msgstr "Изменено, не применено"

msgid "Working…"
msgstr "Выполняется…"

msgid "Something went wrong. Reload the page and try again."
msgstr "Что-то пошло не так. Перезагрузите страницу и попробуйте ещё раз."

msgid "Images by attribute"
msgstr "Изображения по атрибуту"

msgid "Hide"
msgstr "Скрыть"

msgid "Show"
msgstr "Показать"

msgid "WooCommerce variation gallery"
msgstr "галерея вариаций WooCommerce"

msgid "WoodMart variation gallery"
msgstr "галерея вариаций WoodMart"

msgid "Additional Variation Images Gallery plugin"
msgstr "плагин Additional Variation Images Gallery"

msgid "Add attributes used for variations first and save them."
msgstr "Сначала добавьте атрибуты для вариаций и сохраните их."

msgid "Share images by:"
msgstr "Общие изображения по:"

msgid "The panel shows the current images of the variations. Nothing changes until you press “Apply” in a row: only the variations of that value are changed."
msgstr "Панель показывает текущие изображения вариаций. Ничего не меняется, пока вы не нажмёте «Применить» в строке: меняются только вариации этого значения."

#, php-format
msgid "Additional images are saved to: %s."
msgstr "Доп. изображения сохраняются в: %s."

msgid "This site has no variation gallery, so only the main image of the variations is shared."
msgstr "На этом сайте нет галереи вариаций, поэтому раздаётся только основное изображение."

msgid "Undo"
msgstr "Отменить"

msgid "Main image"
msgstr "Основное изображение"

msgid "Additional images (gallery)"
msgstr "Доп. изображения (галерея)"

msgid "Variations"
msgstr "Вариации"

msgid "Choose"
msgstr "Выбрать"

msgid "Remove"
msgstr "Убрать"

msgid "Choose"
msgstr "Выбрать"

msgid "Remove"
msgstr "Убрать"

msgid "Replace in all"
msgstr "Заменить у всех"

msgid "Only empty ones"
msgstr "Только у пустых"

msgid "Cancel"
msgstr "Отмена"

msgid "No variations"
msgstr "Нет вариаций"

msgid "all the same"
msgstr "у всех одинаковые"

msgid "Nothing to change: the variations already had these images."
msgstr "Нечего менять: у вариаций уже были эти изображения."

#, php-format
msgid "Last change: %1$s, %2$d variation."
msgid_plural "Last change: %1$s, %2$d variations."
msgstr[0] "Последнее изменение: %1$s, %2$d вариация."
msgstr[1] "Последнее изменение: %1$s, %2$d вариации."
msgstr[2] "Последнее изменение: %1$s, %2$d вариаций."

#, php-format
msgid "Apply to %d variation"
msgid_plural "Apply to %d variations"
msgstr[0] "Применить к %d вариации"
msgstr[1] "Применить к %d вариациям"
msgstr[2] "Применить к %d вариациям"

#, php-format
msgid "%d variation uses “Any” for this attribute and is not changed."
msgid_plural "%d variations use “Any” for this attribute and are not changed."
msgstr[0] "%d вариация использует «Любое значение» для этого атрибута и не изменяется."
msgstr[1] "%d вариации используют «Любое значение» для этого атрибута и не изменяются."
msgstr[2] "%d вариаций используют «Любое значение» для этого атрибута и не изменяются."

#, php-format
msgid "%d variation"
msgid_plural "%d variations"
msgstr[0] "%d вариация"
msgstr[1] "%d вариации"
msgstr[2] "%d вариаций"

#, php-format
msgid "%d with other images"
msgid_plural "%d with other images"
msgstr[0] "у %d другие фото"
msgstr[1] "у %d другие фото"
msgstr[2] "у %d другие фото"

#, php-format
msgid "%d without images"
msgid_plural "%d without images"
msgstr[0] "%d без фото"
msgstr[1] "%d без фото"
msgstr[2] "%d без фото"

#, php-format
msgid "%d variation already has other images. Replace them too?"
msgid_plural "%d variations already have other images. Replace them too?"
msgstr[0] "У %d вариации уже другие изображения. Заменить и их?"
msgstr[1] "У %d вариаций уже другие изображения. Заменить и их?"
msgstr[2] "У %d вариаций уже другие изображения. Заменить и их?"

#, php-format
msgid "Done: %d variation updated."
msgid_plural "Done: %d variations updated."
msgstr[0] "Готово: обновлена %d вариация."
msgstr[1] "Готово: обновлены %d вариации."
msgstr[2] "Готово: обновлено %d вариаций."

#, php-format
msgid "Undone: %d variation restored."
msgid_plural "Undone: %d variations restored."
msgstr[0] "Отменено: восстановлена %d вариация."
msgstr[1] "Отменено: восстановлены %d вариации."
msgstr[2] "Отменено: восстановлено %d вариаций."

#, php-format
msgid "New variations: %d got the images of their value."
msgid_plural "New variations: %d got the images of their value."
msgstr[0] "Новые вариации: %d получила изображения своего значения."
msgstr[1] "Новые вариации: %d получили изображения своего значения."
msgstr[2] "Новые вариации: %d получили изображения своего значения."
